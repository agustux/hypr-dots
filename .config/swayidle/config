timeout 60 'brightnessctl -s set 1; brightnessctl -sd rgb:kbd_backlight set 0' resume 'brightnessctl -r; brightnessctl -rd rgb:kbd_backlight'
timeout 90 'loginctl lock-session'
timeout 95 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'
timeout 180 '~/.config/sway/idle-suspend.sh'
lock 'pidof swaylock || swaylock -f -i $HOME/.config/hypr/wallpapers/daniel-leone-mocha.jpg'
before-sleep 'pidof swaylock || swaylock -f -i $HOME/.config/hypr/wallpapers/daniel-leone-mocha.jpg'
after-resume 'swaymsg "output * power on"'
