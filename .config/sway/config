# ==========================================
# Variables
# ==========================================
set $mod Mod4
set $terminal ghostty
set $terminal_flags --gtk-single-instance=true
set $fileManager nautilus
set $browser brave-origin

# ==========================================
# Output & Display Configuration (Auto iGPU/Resolution)
# ==========================================

exec_always ~/.config/sway/sway-outputs.sh

# ==========================================
# Autostart Daemons & Services
# ==========================================
exec $terminal $terminal_flags
output * bg ~/.config/hypr/wallpapers/daniel-leone-mocha.jpg fill
exec waybar -c ~/.config/waybar/config.sway
exec dunst
exec swayidle -w

exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP PATH
exec /usr/lib/hyprpolkitagent/hyprpolkitagent
exec gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
exec gsettings set org.gnome.desktop.interface gtk-theme "adw-gtk3"
exec xhost +SI:localuser:root

# ==========================================
# Environment Variables
# ==========================================
seat seat0 xcursor_theme default 24

# ==========================================
# Look and Feel (Catppuccin Mocha / Sapphire)
# ==========================================
gaps inner 3
gaps outer 6
default_border pixel 2
smart_borders on

# Colors: Catppuccin Mocha with Sapphire accent (#74c7ec)
# class                 border  background text    indicator child_border
client.focused          #74c7ec #181825    #cdd6f4   #74c7ec   #74c7ec
client.unfocused        #585b70 #181825    #a6adc8   #585b70   #585b70
client.focused_inactive #585b70 #181825    #a6adc8   #585b70   #585b70
client.placeholder      #181825 #181825    #cdd6f4   #181825   #181825
client.urgent           #f38ba8 #181825    #cdd6f4   #f38ba8   #f38ba8

# ==========================================
# Input Configuration
# ==========================================
input * {
    xkb_layout "us"
    pointer_accel "0"
}

input type:touchpad {
    natural_scroll enabled
    tap enabled
}

# ==========================================
# Keybindings
# ==========================================
# Core utilities
bindsym $mod+Q exec $terminal $terminal_flags
bindsym $mod+E exec $fileManager
bindsym $mod+B exec $browser
bindsym $mod+R exec rofi -show drun
bindsym $mod+W exec killall waybar || waybar -c ~/.config/waybar/config.sway
bindsym $mod+Shift+Q exec loginctl lock-session
bindsym $mod+M exec swaymsg exit

# Screenshots (using grimshot drop-in replacements)
bindsym PRINT exec grimshot save area $HOME/Pictures/Screenshots/$(date +'%Y%m%d_%H%M%S.png')
bindsym Alt+PRINT exec grimshot save active $HOME/Pictures/Screenshots/$(date +'%Y%m%d_%H%M%S.png')
bindsym $mod+PRINT exec grimshot save output $HOME/Pictures/Screenshots/$(date +'%Y%m%d_%H%M%S.png')
bindsym $mod+Shift+P exec grimshot save area $HOME/Pictures/Screenshots/$(date +'%Y%m%d_%H%M%S.png')
bindsym $mod+Alt+P exec grimshot save active $HOME/Pictures/Screenshots/$(date +'%Y%m%d_%H%M%S.png')
bindsym $mod+Ctrl+P exec grimshot save output $HOME/Pictures/Screenshots/$(date +'%Y%m%d_%H%M%S.png')

# Window management
bindsym $mod+C kill
bindsym $mod+T layout toggle split
bindsym $mod+V floating toggle
bindsym $mod+F fullscreen toggle

# Move focus with Vim keys
bindsym $mod+H focus left
bindsym $mod+J focus down
bindsym $mod+K focus up
bindsym $mod+L focus right

# Move windows with Vim keys
bindsym $mod+Shift+H move left
bindsym $mod+Shift+J move down
bindsym $mod+Shift+K move up
bindsym $mod+Shift+L move right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Scratchpad ("ghoulag")
bindsym $mod+S scratchpad toggle
bindsym $mod+Shift+S move scratchpad

# Mouse bindings
floating_modifier $mod normal

# Lid switch triggers suspend
bindswitch --locked lid:on exec loginctl lock-session && systemctl suspend

# Multimedia keys
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl -e4 -n2 set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl -e4 -n2 set 5%-
bindsym XF86KbdBrightnessUp exec brightnessctl -d '*kbd_backlight' set 10%+
bindsym XF86KbdBrightnessDown exec brightnessctl -d '*kbd_backlight' set 10%-

bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPrev exec playerctl previous
